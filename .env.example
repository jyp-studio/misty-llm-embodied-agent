# Copy to `.env` and edit. Every field in misty_agent/config.py can be set here
# with the MISTY_ prefix; anything omitted uses the default in that module.
#
#   cp .env.example .env
#
# `.env` is gitignored. Do not put your OpenAI key here — it is read from
# OPENAI_API_KEY or OAI_CONFIG_LIST.json.

# ---------------------------------------------------------------------------
# Robot
# ---------------------------------------------------------------------------
MISTY_ROBOT_IP=192.168.1.237

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
MISTY_LLM_MODEL=gpt-4o
MISTY_MEMORY_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# CALIBRATION — these describe the physical robot and are NOT verified against
# hardware in this project. Treat the defaults as assumptions. If you do have a
# Misty II, these are the values to measure first.
# ---------------------------------------------------------------------------

# Travel speed (cm/s) at MISTY_DRIVE_PERCENT.
#   drive_time(linearVelocity=20, angularVelocity=0, timeMs=2000)
#   -> measure the distance travelled in cm, divide by 2.
MISTY_CM_PER_SEC_AT_PERCENT=22.0

# Drive speed as a PERCENT of max speed, not a physical unit. Raise it if the
# motors stall — the deadband is unknown.
MISTY_DRIVE_PERCENT=20

# Camera focal constant for the face-width distance estimate.
#   Stand at exactly 100 cm, then scale: new = 650 * actual_cm / reported_cm
MISTY_FOCAL_LENGTH=650.0

# Latency from camera exposure to the frame arriving in this process
# (encode + RTSP over WiFi). Unmeasurable without hardware. NOT YET WIRED — the
# replay harness that injects it arrives at M4.
# MISTY_SENSOR_TRANSPORT_LAG_S=0.0

# ---------------------------------------------------------------------------
# Control law — pure software. Cross-field constraints are enforced at load
# time; an invalid combination fails immediately rather than at runtime.
#   Required: MISTY_TARGET_DISTANCE_CM - MISTY_DISTANCE_TOLERANCE_CM
#             > MISTY_MIN_SAFE_DISTANCE_CM
# ---------------------------------------------------------------------------
MISTY_TARGET_DISTANCE_CM=60.0
MISTY_DISTANCE_TOLERANCE_CM=12.0
MISTY_MIN_SAFE_DISTANCE_CM=45.0
MISTY_MAX_STEP_CM=35.0
MISTY_MIN_STEP_CM=8.0
MISTY_APPROACH_GAIN=0.7
MISTY_MAX_APPROACH_STEPS=8

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
MISTY_MEMORY_WINDOW=10
MISTY_MEMORY_FOLD_SIZE=4
MISTY_LLM_TEMPERATURE=0.5
MISTY_TRIGGER_COOLDOWN_S=3.0

# ---------------------------------------------------------------------------
# DECLARED BUT NOT YET WIRED — these fields exist in misty_agent/config.py and
# validate, but nothing reads them yet. Setting them changes nothing today.
#   MISTY_MAX_REACT_STEPS         -> the ReAct loop lands at M8
#   MISTY_SENSOR_TRANSPORT_LAG_S  -> the replay harness that injects it is M4
# ---------------------------------------------------------------------------
# MISTY_MAX_REACT_STEPS=5
