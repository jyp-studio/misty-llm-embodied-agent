# Copy to `.env` and edit. Every field in misty_agent/config.py can be set here
# with the MISTY_ prefix; anything omitted uses the default in that module.
#
#   cp .env.example .env
#
# `.env` is gitignored. Do not put your OpenAI key here — it is read from
# OPENAI_API_KEY or OAI_CONFIG_LIST.json.

# ---------------------------------------------------------------------------
# Robot
# ---------------------------------------------------------------------------
MISTY_ROBOT_IP=192.168.1.237

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
MISTY_LLM_MODEL=gpt-5.6-luna
# On Chat Completions with function tools, the GPT-5.6 family accepts no
# reasoning effort but 'none'.
MISTY_LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# CALIBRATION — these describe the physical robot and are NOT verified against
# hardware in this project. Treat the defaults as assumptions. If you do have a
# Misty II, these are the values to measure first.
# ---------------------------------------------------------------------------

# Travel speed (cm/s) at MISTY_DRIVE_PERCENT.
#   drive_time(linearVelocity=20, angularVelocity=0, timeMs=2000)
#   -> measure the distance travelled in cm, divide by 2.
MISTY_CM_PER_SEC_AT_PERCENT=22.0

# Drive speed as a PERCENT of max speed, not a physical unit. Raise it if the
# motors stall — the deadband is unknown.
MISTY_DRIVE_PERCENT=20

# Camera focal constant for the face-width distance estimate.
#   Stand at exactly 100 cm, then scale: new = 650 * actual_cm / reported_cm
MISTY_FOCAL_LENGTH=650.0

# Latency from camera exposure to the frame arriving in this process
# (encode + RTSP over WiFi). UNCALIBRATED: unmeasurable without hardware
# (PLAN.md §8). harness/robustness.py reads it as the left edge of its sweep,
# so setting it moves where the robustness envelope is reported from; it does
# not change what the agent does at runtime.
# MISTY_SENSOR_TRANSPORT_LAG_S=0.0

# ---------------------------------------------------------------------------
# Control law — pure software. Cross-field constraints are enforced at load
# time; an invalid combination fails immediately rather than at runtime.
#   Required: MISTY_TARGET_DISTANCE_CM - MISTY_DISTANCE_TOLERANCE_CM
#             > MISTY_MIN_SAFE_DISTANCE_CM
#   Required: MISTY_TARGET_DISTANCE_CM < MISTY_COMFORTABLE_DISTANCE_CM
#             < MISTY_FAR_DISTANCE_CM
# ---------------------------------------------------------------------------
MISTY_TARGET_DISTANCE_CM=60.0
MISTY_DISTANCE_TOLERANCE_CM=12.0
# Where approach(keep=comfortable|far) converges instead. UNCALIBRATED.
MISTY_COMFORTABLE_DISTANCE_CM=100.0
MISTY_FAR_DISTANCE_CM=150.0
MISTY_MIN_SAFE_DISTANCE_CM=45.0
MISTY_MAX_STEP_CM=35.0
MISTY_MIN_STEP_CM=8.0
MISTY_APPROACH_GAIN=0.7
MISTY_MAX_APPROACH_STEPS=8

# ---------------------------------------------------------------------------
# Drivers — audio-video stream
# ---------------------------------------------------------------------------
MISTY_AV_STREAM_PORT=1935
MISTY_AV_STREAM_WIDTH=640
MISTY_AV_STREAM_HEIGHT=480

# Clockwise rotation putting the picture upright. 0, 90, 180 or 270.
MISTY_CAMERA_ROTATE_DEGREES=90

# Pause after tearing down a previous AV session. UNCALIBRATED.
MISTY_AV_RESET_SETTLE_S=2.0

# ---------------------------------------------------------------------------
# Drivers — hearing
# ---------------------------------------------------------------------------
MISTY_ASR_MODEL=gpt-4o-mini-transcribe

# RMS level (dB) below which audio counts as silence, and how much silence ends
# one utterance. MISTY_SILENCE_DURATION_S must stay below MISTY_SILENCE_TIMEOUT_S,
# which ends a whole conversational turn.
MISTY_SILENCE_THRESHOLD_DB=-40.0
MISTY_SILENCE_DURATION_S=0.5
MISTY_SILENCE_TIMEOUT_S=4.0
MISTY_MIN_UTTERANCE_S=0.3
MISTY_MAX_UTTERANCE_S=8.0

# Fixed capacities keep AV input bounded while wake/ASR consumers are busy.
MISTY_AUDIO_BLOCK_QUEUE_CAPACITY=64
MISTY_AUDIO_SEGMENT_QUEUE_CAPACITY=3

# Audio kept from before speech starts, so the first phoneme is not clipped.
MISTY_AUDIO_PREROLL_S=0.3

# Transcripts containing any of these are dropped — a workaround for local
# Whisper hallucinating politeness over near-silence. It also means a real
# "thanks" goes unheard, so it is worth re-measuring against the hosted model
# and setting this empty.
MISTY_ASR_IGNORED_PHRASES=["thank you","thanks","thank"]
MISTY_ASR_TIMEOUT_S=15.0

# Local PocketSphinx grammar score. Verified only with synthetic fixtures;
# real-room and Misty microphone calibration remain hardware-unverified.
MISTY_WAKE_MINIMUM_CONFIDENCE=0.68

# Sample rate Misty's RTSP audio arrives at. UNCALIBRATED.
MISTY_AUDIO_SAMPLE_RATE_HZ=44100

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
MISTY_TRIGGER_COOLDOWN_S=3.0
MISTY_CUE_QUEUE_CAPACITY=3
MISTY_CUE_FRESHNESS_S=5.0
MISTY_CUE_SUPPRESSION_S=30.0
# Hard cap on model Turns in one Episode; every Episode provably ends.
MISTY_MAX_TURNS_PER_EPISODE=12
